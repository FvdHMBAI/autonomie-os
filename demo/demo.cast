[3.693847, "o", "  \u001b[0;32m+\u001b[0m \u001b[1mLearning 1:\u001b[0m TypeScript strict mode catches 12% more bugs\r\n    \u001b[2mEvidence: 3 sessions fixed type errors that eslint missed\u001b[0m\r\n"]
